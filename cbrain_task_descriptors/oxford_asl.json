{
    "tool-version": "6.0.4",
    "name": "oxford_asl",
    "author": "Oxford Centre for Functional MRI of the Brain (FMRIB)",
    "description": "oxford_asl is part of BASIL (https://asl-docs.readthedocs.io/en/latest/oxford_asl_userguide.html)",
    "descriptor-url": "https://github.com/aces/cbrain-plugins-neuro/blob/master/cbrain_task_descriptors/oxford_asl.json",
    "command-line": "if [ -n '[INPUT_FILE]' ] || [ -n '[INPUT_DIR]' ]; then fsl_anat [INPUT_FILE] [INPUT_DIR] [FSL_OUTPUT] [CLOBBER_FLAG] [WEAKBIAS_FLAG] [NO_REORIENT_FLAG] [NO_CROP_FLAG] [NO_BIAS_FLAG] [NO_REGISTRATION_FLAG] [NO_NONLINEAR_REG_FLAG] [NO_SEG_FLAG] [NO_SUBCORTSEG_FLAG] [NO_SEARCH_FLAG] [NO_CLEANUP_FLAG] [BIAS_FIELD_SMOOTHING_VAL] [IMAGE_TYPE] [BET_F_PARAM]; fi; oxford_asl [INPUT_FILE] [OUTPUT_DIR] [MASK] [SPATIAL] [WP] [MC] [IAF] [IBF] [TIS] [TIIMG] [CASL] [ARTSUPP] [FIXBOLUS] [BOLUS] [BAT] [T1] [T1B] [SLICEDT] [SLICEBAND] [RPTS] [FSLANAT] [FSLANAT_FRESH] [S] [SBRAIN] [FASTSRC] [SENSCORR] [M0] [ALPHA] [C] [TR] [CMETHOD] [TE] [T2BL] [T2CSF] [CBLIP] [PEDIR] [ECHOSPACING] [PVCORR]; ",
    "schema-version": "0.5",
    "container-image": {
        "image": "mcin/docker-fsl:latest",
        "index": "docker://",
        "type": "singularity"
    },
    "inputs": [
        {
            "command-line-flag": "-i",
            "description": "ASL data input",
            "value-key": "[INPUT_FILE]",
            "type": "File",
            "list": false,
            "optional": false,
            "id": "asl_data",
            "name": "Asl data"
        },
        {
            "command-line-flag": "-m",
            "description": "Mask (in native space of ASL data) - {default: automatically generated}",
            "value-key": "[MASK]",
            "type": "File",
            "list": false,
            "optional": true,
            "id": "mask",
            "name": "Mask"
        },
        {
            "command-line-flag": "--spatial",
            "command-line-flag-separator": "=",
            "description": "Perform ASL analysis with automatic spatial smoothing of CBF (could be set to 'off')",
            "value-choices": [
                "on",
                "off"
            ],
            "value-key": "[SPATIAL]",
            "type": "String",
            "list": false,
            "optional": true,
            "id": "spatial",
            "name": "Spatial smoothing"
        },
        {
            "command-line-flag": "--wp",
            "description": "Analysis that conforms to the 'white paper' (Alsop et al. 2014)",
            "value-key": "[WP]",
            "type": "Flag",
            "list": false,
            "optional": true,
            "id": "white_perform",
            "name": "White paper mode"
        },
        {
            "command-line-flag": "--mc",
            "description": "Apply motion correction using mcflirt",
            "value-key": "[MC]",
            "type": "Flag",
            "list": false,
            "optional": true,
            "id": "motion_correction",
            "name": "Motion correction"
        },
        {
            "command-line-flag": "--iaf",
            "description": "Input ASL format",
            "value-key": "[IAF]",
            "value-choices": [
                "diff",
                "tc",
                "ct"
            ],
            "default-value": "diff",
            "type": "String",
            "list": false,
            "optional": true,
            "id": "iaf",
            "name": "Input ASL format"
        },
        {
            "command-line-flag": "--ibf",
            "description": "Input block format (for multi-TI)",
            "value-key": "[IBF]",
            "value-choices": [
                "rpt",
                "tis"
            ],
            "type": "String",
            "list": false,
            "optional": true,
            "id": "ibf",
            "name": "Input block format"
        },
        {
            "command-line-flag": "--tis",
            "command-line-flag-separator": "=",
            "description": "comma separated list of inflow times in seconds, e.g. --tis 0.2,0.4,0.6",
            "value-key": "[TIS]",
            "type": "String",
            "list": false,
            "optional": true,
            "id": "tis",
            "name": "Inversion time"
        },
        {
            "command-line-flag": "--tiimg",
            "description": "4D image containing voxelwise TI values",
            "value-key": "[TIIMG]",
            "type": "File",
            "list": false,
            "optional": true,
            "id": "tiimg",
            "name": "4D image"
        },
        {
            "command-line-flag": "--casl",
            "description": "ASL acquisition is  pseudo cASL (pcASL) rather than pASL",
            "value-key": "[CASL]",
            "type": "Flag",
            "list": false,
            "optional": true,
            "id": "casl",
            "name": "Casl"
        },
        {
            "command-line-flag": "--artsupp",
            "description": "Arterial suppression (vascular crushing) was used, same as artoff",
            "value-key": "[ARTSUPP]",
            "type": "Flag",
            "list": false,
            "optional": true,
            "id": "artsupp",
            "name": "Arterial suppression"
        },
        {
            "command-line-flag": "--fixbolus",
            "description": "Turn off automatic estimation of bolus duration as it is fixed, e.g. by QUIPSSII or CASL",
            "value-key": "[FIXBOLUS]",
            "type": "String",
            "list": false,
            "optional": true,
            "id": "fixbolus",
            "name": "Bolus duration"
        },
        {
            "command-line-flag": "--bolus",
            "command-line-flag-separator": "=",
            "description": "Duration of the ASL labeling bolus in seconds - {default: 1}",
            "value-key": "[BOLUS]",
            "type": "String",
            "list": false,
            "optional": true,
            "id": "bolus",
            "name": "Bolus duration"
        },
        {
            "command-line-flag": "--bat",
            "command-line-flag-separator": "=",
            "description": "Bolus arrival time in seconds - {default: 0.7 (pASL); 1.3 (cASL)}",
            "value-key": "[BAT]",
            "type": "String",
            "list": false,
            "optional": true,
            "id": "bat",
            "name": "Bolus arrival time"
        },
        {
            "command-line-flag": "--t1",
            "command-line-flag-separator": "=",
            "description": "Tissue T1 value - {default: 1.3}",
            "value-key": "[T1]",
            "default-value": "1.3",
            "type": "String",
            "list": false,
            "optional": true,
            "id": "t1",
            "name": "Tissue T1 value"
        },
        {
            "command-line-flag": "--t1b",
            "command-line-flag-separator": "=",
            "description": "Blood T1 value - {default: 1.65}",
            "value-key": "[T1B]",
            "default-value": "1.65",
            "type": "String",
            "list": false,
            "optional": true,
            "id": "t1b",
            "name": "Blood T1"
        },
        {
            "command-line-flag": "--slicedt",
            "command-line-flag-separator": "=",
            "description": "Timing difference between slices in seconds - {default: 0}",
            "value-key": "[SLICEDT]",
            "default-value": "0",
            "type": "String",
            "list": false,
            "optional": true,
            "id": "slicedt",
            "name": "Timing difference"
        },
        {
            "command-line-flag": "--sliceband",
            "command-line-flag-separator": "=",
            "description": "Number of slices per band in a multi-band setup",
            "value-key": "[SLICEBAND]",
            "type": "String",
            "list": false,
            "optional": true,
            "id": "sliceband",
            "name": "Number of slices"
        },
        {
            "command-line-flag": "--rpts",
            "command-line-flag-separator": "=",
            "description": " Number of repeated measurements for each TI/PLD in the TIs list, for use where the number of repeated measurements varies at each TI.",
            "value-key": "[RPTS]",
            "type": "String",
            "list": false,
            "optional": true,
            "id": "rpts",
            "name": "Number of repeated measurements"
        },
        {
            "command-line-flag": "--fslanat",
            "command-line-flag-separator": "=",
            "description": "An existing fsl_anat directory from structural image",
            "value-key": "[FSLANAT]",
            "type": "File",
            "list": false,
            "optional": true,
            "id": "fslanat",
            "name": "fsl_anat directory"
        },
        {
            "command-line-flag": "-i",
            "description": "Run Anat FSL with a single input image file, such as .nii.gz. Either this or an input dir (-d) must be provided to FSL Anat, but not both.",
            "value-key": "[INPUT_FILE]",
            "type": "File",
            "list": false,
            "optional": true,
            "id": "infile",
            "name": "Input file"
        },
        {
            "command-line-flag": "-d",
            "description": "Run Anat FSL on an existing input directory (.anat extension). Either this or an input file (-i) can be provided, but not both.",
            "value-key": "[INPUT_DIR]",
            "type": "File",
            "list": false,
            "optional": true,
            "id": "indir",
            "name": "Input Dir"
        },
        {
            "command-line-flag": "-o",
            "description": "(Anat FSL) Specifies the output folder name. Note that the .anat extension is automatically appended.",
            "default-value": "output_results",
            "value-key": "[OUTPUT_DIR]",
            "default-value": "fslout",
            "type": "String",
            "list": false,
            "optional": false,
            "id": "outdir",
            "name": "FSL Output directory"
        },
        {
            "command-line-flag": "--clobber",
            "description": "(Anat FSL) If .anat directory exist (as specified by -o or default from -i) then delete it and make a new one.",
            "value-key": "[CLOBBER_FLAG]",
            "type": "Flag",
            "list": false,
            "optional": true,
            "id": "clobber_flag",
            "name": "Clobber flag"
        },
        {
            "command-line-flag": "--weakbias",
            "description": "(Anat FSL) Used for images with little and/or smooth bias fields. For images acquired using birdcage coils or on 1.5T scanners, the --weakbias option will be faster and may produce equally good results.",
            "value-key": "[WEAKBIAS_FLAG]",
            "type": "Flag",
            "list": false,
            "optional": true,
            "id": "weak_bias",
            "name": "Weak bias flag"
        },
        {
            "command-line-flag": "--noreorient",
            "description": "(Anat FSL) Turn off step that does reorientation 2 standard (fslreorient2std).",
            "value-key": "[NO_REORIENT_FLAG]",
            "type": "Flag",
            "list": false,
            "optional": true,
            "id": "no_reorient_flag",
            "name": "No reorienation flag"
        },
        {
            "command-line-flag": "--nocrop",
            "description": "(Anat FSL) Turn off step that does automated cropping (robustfov).",
            "value-key": "[NO_CROP_FLAG]",
            "type": "Flag",
            "list": false,
            "optional": true,
            "id": "no_crop_flag",
            "name": "No automated cropping flag"
        },
        {
            "command-line-flag": "--nobias",
            "description": "(Anat FSL) Turn off steps that do bias field correction (via FAST).",
            "value-key": "[NO_BIAS_FLAG]",
            "type": "Flag",
            "list": false,
            "optional": true,
            "id": "no_bias_flag",
            "name": "No bias field correction flag"
        },
        {
            "command-line-flag": "--noreg",
            "description": "(Anat FSL) Turn off steps that do registration to standard (FLIRT and FNIRT).",
            "value-key": "[NO_REGISTRATION_FLAG]",
            "type": "Flag",
            "list": false,
            "optional": true,
            "id": "no_reg_flag",
            "name": "No registration flag"
        },
        {
            "command-line-flag": "--nononlinreg",
            "description": "(Anat FSL) Turn off step that does non-linear registration (FNIRT).",
            "value-key": "[NO_NONLINEAR_REG_FLAG]",
            "type": "Flag",
            "list": false,
            "optional": true,
            "id": "no_nonlin_reg_flag",
            "name": "No non-linear registration flag"
        },
        {
            "command-line-flag": "--noseg",
            "description": "(Anat FSL) Turn off step that does tissue-type segmentation (FAST).",
            "value-key": "[NO_SEG_FLAG]",
            "type": "Flag",
            "list": false,
            "optional": true,
            "id": "no_seg_flag",
            "name": "No tissue-type segmentation flag"
        },
        {
            "command-line-flag": "--nosubcortseg",
            "description": "(Anat FSL) Turn off step that does sub-cortical segmentation (FIRST).",
            "value-key": "[NO_SUBCORTSEG_FLAG]",
            "type": "Flag",
            "list": false,
            "optional": true,
            "id": "no_subcort_seg_flag",
            "name": "No subcortical segmentation flag"
        },
        {
            "command-line-flag": "--nosearch",
            "description": "(Anat FSL) Specify that linear registration uses the -nosearch option (FLIRT).",
            "value-key": "[NO_SEARCH_FLAG]",
            "type": "Flag",
            "list": false,
            "optional": true,
            "id": "no_search_flag",
            "name": "No search in linear registration flag"
        },
        {
            "command-line-flag": "--nocleanup",
            "description": "(Anat FSL) Do not remove intermediate files.",
            "value-key": "[NO_CLEANUP_FLAG]",
            "type": "Flag",
            "list": false,
            "optional": true,
            "id": "no_cleanup_flag",
            "name": "No cleanup flag"
        },
        {
            "command-line-flag": "-s",
            "description": "(Anat FSL) Specify the value for bias field smoothing (the -l option in FAST).",
            "value-key": "[BIAS_FIELD_SMOOTHING_VAL]",
            "type": "Number",
            "list": false,
            "optional": true,
            "id": "bias_field_smoothing_val",
            "name": "Bias field smoothing value"
        },
        {
            "command-line-flag": "-t",
            "description": "(Anat FSL) Specify the type of image (choose one of T1 T2 PD - default is T1).",
            "value-key": "[IMAGE_TYPE]",
            "type": "String",
            "list": false,
            "value-choices": [
                "T1",
                "T2",
                "PD"
            ],
            "optional": true,
            "id": "image_type",
            "name": "Image type"
        },
        {
            "command-line-flag": "--betfparam",
            "description": "(Anat FSL) specify the f parameter for BET (only used if not running non-linear reg and also wanting brain extraction done).",
            "value-key": "[BET_F_PARAM]",
            "type": "Number",
            "list": false,
            "requires-inputs": [
                "no_nonlin_reg_flag"
            ],
            "maximum": 1,
            "minimum": 0,
            "command-line-flag-separator": "=",
            "optional": true,
            "id": "bet_f_param",
            "name": "F-parameter value for BET"
        },
        {
            "command-line-flag": "-s",
            "description": "Structural image (whole head)",
            "value-key": "[S]",
            "type": "File",
            "list": false,
            "optional": true,
            "id": "s",
            "name": "Structural image"
        },
        {
            "command-line-flag": "--sbrain",
            "description": "Structural image (already BETed)",
            "value-key": "[SBRAIN]",
            "type": "File",
            "list": false,
            "optional": true,
            "id": "sbrain",
            "name": "Structural image"
        },
        {
            "command-line-flag": "--fastsrc",
            "description": "Images from a FAST segmenation - if not set FAST will be run on structural",
            "value-key": "[FASTSRC]",
            "type": "File",
            "list": false,
            "optional": true,
            "id": "fastsrc",
            "name": "Images from FAST"
        },
        {
            "command-line-flag": "--senscorr",
            "description": "use bias field (from segmentation) for sensitivity correction",
            "value-key": "[SENSCORR]",
            "type": "Flag",
            "list": false,
            "optional": true,
            "id": "senscorr",
            "name": "Bias field"
        },
        {
            "command-line-flag": "--M0",
            "description": "(single) precomputed M0 value (e.g. from having run a separate calibration)",
            "value-key": "[M0]",
            "type": "String",
            "list": false,
            "optional": true,
            "id": "m0",
            "name": "M0 value"
        },
        {
            "command-line-flag": "--alpha",
            "description": "Inversion efficiency - {default: 0.98 (pASL); 0.85 (cASL)}",
            "value-key": "[ALPHA]",
            "type": "String",
            "list": false,
            "optional": true,
            "id": "alpha",
            "name": "Inversion efficiency"
        },
        {
            "command-line-flag": "-c",
            "description": "M0 calibration image (proton density or mean control image)",
            "value-key": "[C]",
            "type": "File",
            "list": false,
            "optional": true,
            "id": "c",
            "name": "M0 calibration"
        },
        {
            "command-line-flag": "--tr",
            "description": "Repetition time of calibration in seconds - {default: 3.2 s}",
            "default-value": "3.2",
            "value-key": "[TR]",
            "type": "String",
            "list": false,
            "optional": true,
            "id": "tr",
            "name": "TR of calibration"
        },
        {
            "command-line-flag": "--cmethod",
            "description": "Single - default if structural image is supplied M0 value will be calculated within automatically created CSF mask || voxel  - default if no structral image is supplied voxelwise M0 values derrived from calibration image",
            "value-choices": [
                "single",
                "voxel"
            ],
            "value-key": "[CMETHOD]",
            "type": "String",
            "list": false,
            "optional": true,
            "id": "cmethod",
            "name": "Calibration method"
        },
        {
            "command-line-flag": "--t2csf",
            "description": "Value for T2 of CSF in millisecond for calibration - {default is based on 3T Field Strength}",
            "value-key": "[T2CSF]",
            "type": "String",
            "list": false,
            "optional": true,
            "id": "t2csf",
            "name": "T2 CSF"
        },
        {
            "command-line-flag": "--t2bl",
            "description": "Value for T2 of blood in millisecond for calibration - {default: 0}",
            "value-key": "[T2BL]",
            "type": "String",
            "list": false,
            "optional": true,
            "id": "t2bl",
            "name": "T2 Blood"
        },
        {
            "command-line-flag": "--te",
            "description": "Echo time for readout in milliseconds - {default: 0}",
            "default-value": "",
            "value-key": "[TE]",
            "type": "String",
            "list": false,
            "optional": true,
            "id": "te",
            "name": "TE time"
        },
        {
            "command-line-flag": "--cblip",
            "description": "Phase-encode-reversed (blipped) calibration image",
            "value-key": "[CBLIP]",
            "type": "File",
            "list": false,
            "optional": true,
            "id": "cblip",
            "name": "Blipped calibration"
        },
        {
            "command-line-flag": "--pedir",
            "command-line-flag-separator": "=",
            "description": "Phase encoding direction",
            "value-key": "[PEDIR]",
            "value-choices": [
                "x",
                "y",
                "z",
                "-x",
                "-y",
                "-z"
            ],
            "type": "String",
            "list": false,
            "optional": true,
            "id": "pedir",
            "name": "Direction"
        },
        {
            "command-line-flag": "--echospacing",
            "command-line-flag-separator": "=",
            "description": "Effective EPI echo spacing (sometimes called dwell time) in seconds",
            "value-key": "[ECHOSPACING]",
            "type": "String",
            "list": false,
            "optional": true,
            "id": "echospacing",
            "name": "EPI"
        },
        {
            "command-line-flag": "--pvcorr",
            "description": "Do partial volume correction",
            "value-key": "[PVCORR]",
            "type": "Flag",
            "list": false,
            "optional": true,
            "id": "pvcorr",
            "name": "Volume correction"
        }
    ],
    "groups": [
        {
            "id": "acquisition",
            "name": "Acquisition specific/Data specific",
            "members": [
                "iaf",
                "ibf",
                "tis",
                "tiimg",
                "casl",
                "artsupp",
                "fixbolus",
                "bolus",
                "bat",
                "t1",
                "t1b",
                "slicedt",
                "sliceband",
                "rpts"
            ]
        },
        {
            "id": "structural",
            "name": "Structural image",
            "members": [
                "s",
                "sbrain",
                "fastsrc",
                "senscorr"
            ]
        },
        {
            "description": "Existing output of FSL Anat or run FSL Anat on either a single image file (e.g. .nii.gz) or directory (.anat extension)",
            "mutually-exclusive": true,
            "members": [
                "fslanat",
                "infile",
                "indir"
            ],
            "id": "group_1",
            "name": "FSL ANAT Structural Input Data "
        },
        {
            "description": "Parameters for controlling the execution of the fsl_anat task",
            "id": "group_2",
            "members": [
                "outdir",
                "clobber_flag",
                "weak_bias",
                "no_reorient_flag",
                "no_crop_flag",
                "no_bias_flag",
                "no_reg_flag",
                "no_nonlin_reg_flag",
                "no_seg_flag",
                "no_subcort_seg_flag",
                "no_search_flag",
                "no_cleanup_flag",
                "bias_field_smoothing_val",
                "image_type",
                "bet_f_param"
            ],
            "name": "Optional Parameters for FSL Anat"
        },
        {
            "id": "calibration",
            "name": "Calibration options",
            "members": [
                "m0",
                "alpha",
                "c",
                "tr",
                "cmethod",
                "te",
                "t2csf",
                "t2bl"
            ]
        },
        {
            "id": "distortion",
            "name": "Distortion correction",
            "members": [
                "cblip",
                "echospacing",
                "pedir"
            ]
        },
        {
            "id": "partial",
            "name": "Partial correction",
            "members": [
                "pvcorr"
            ]
        }

    ],
    "output-files": [
        {
            "id": "outputs",
            "name": "Oxford asl Outputs",
            "description": "Oxford asl Outputs",
            "command-line-flag": "-o",
            "value-key": "[OUTPUT_DIR]",
            "path-template": "[INPUT_FILE]",
            "list": false,
            "path-template-stripped-extensions": [
                ".nii.gz",
                ".nii"
            ]
        },
        {
            "description": "A folder containing the output files for fsl_anat. Includes outputs for the images, reorientation, cropping, bias correction, registration, brain extraction, and segmentation.",
            "list": false,
            "id": "fsl_out",
            "optional": true,
            "path-template": "[FSL_OUTPUT].anat",
            "command-line-flag": "--fslanat",
            "command-line-flag-separator": "=",
            "value-key": "[FSLANAT_NEW]",
            "name": "FSL Anat Output folder"
        }
    ],
    "tags": {
        "domain": [
            "neuroinformatics",
            "mri"
        ]
    },
    "custom": {
        "cbrain:author": "Natacha Beck"
    }
}
