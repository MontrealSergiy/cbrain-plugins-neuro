{
  "name": "mpn_dicom_to_bids",
  "tool-version": "beta20250525sub",
  "author": "Maxime Mulder",
  "description": "Converts a directory of DICOM files to BIDS format using subject and session labels.",
  "url": "https://github.com/BIC-MNI/MPN_DICOM_to_BIDS",
  "command-line": "mpn_dicom_to_bids <INPUT_DICOM_DIR> bids --subject <SUBJECT_LABEL> --session <SESSION_LABEL>",
  "inputs": [
    {
      "id": "input_dicom_dir",
      "name": "Input DICOM dataset for one subject",
      "type": "File",
      "description": "Input directory containing DICOM files for a single subject.",
      "value-key": "<INPUT_DICOM_DIR>",      
      "optional": false
    },
    {
      "id": "subject_label",
      "name": "Subject Label",
      "type": "String",
      "description": "Subject identifier (e.g., '01')",
      "value-key": "<SUBJECT_LABEL>",
      "optional": false
    },
    {
      "id": "session_label",
      "name": "Session Label",
      "type": "String",
      "description": "Session identifier (e.g., '01')",
      "value-key": "<SESSION_LABEL>",
      "optional": false
    }
  ],
  "output-files": [
    {
      "id": "bids_output",
      "name": "Resulting BIDS dataset",
      "path-template": "bids/sub-<SUBJECT_LABEL>"
    }
  ],
  "tags": {
    "domain": [
      "dcm",
      "bids",
      "neuroimaging",
      "File Format Conversion"
    ]
  },
  "suggested-resources": {
    "cpu-cores":         1,
    "ram":               2,
    "walltime-estimate": 1200
  },
  "custom": {
    "cbrain:author": "Sergiy Boroday <sergiy.boroday@mcgill.ca>",
    "cbrain:integrator_modules": {
      "BoutiquesFileTypeVerifier": {
        "input_dicom_dir": [ "DicomCollection" ]
      },
      "BoutiquesOutputFileTypeSetter": {
        "bids_output": "BidsSubject"
      },
      "BoutiquesFileNameVerifier": [
        "output_bids_dir"
      ],
      "BoutiquesInputRegexChecker": {
        "subject_label": [ "[a-zA-Z0-9]+", "must be a sequence of numbers and digits" ],
        "session_label": [ "[a-zA-Z0-9]+", "must be a sequence of numbers and digits" ]
      }
    }
  },
  "schema-version": "0.5"
}



